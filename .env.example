WEBHOOK_SECRET=replace-me

# Default Alpaca route for this project. Leave as "paper" unless you intentionally
# want live account routing.
ALPACA_TRADING_MODE=paper

# Preferred paper trading variables.
APCA_PAPER_API_KEY_ID=replace-me
APCA_PAPER_API_SECRET_KEY=replace-me
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Preferred live trading variables. These are required for broker="alpaca_live".
# APCA_API_KEY_ID=replace-me
# APCA_API_SECRET_KEY=replace-me
# ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# Legacy shared names supported by server.py/alpaca_trader.py for paper/default
# routing. Do not use them for live trading because they make routing ambiguous.
# ALPACA_API_KEY=replace-me
# ALPACA_SECRET_KEY=replace-me
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

MAX_NOTIONAL=10000

# Optional unless you are routing webhooks to Kraken Futures.
# KRAKEN_FUTURES_API_KEY=replace-me
# KRAKEN_FUTURES_API_SECRET=replace-me
# KRAKEN_FUTURES_BASE_URL=https://futures.kraken.com/derivatives/api/v3
