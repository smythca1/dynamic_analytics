#!/usr/bin/env bash
set -euo pipefail

HOST="${DEPLOY_HOST:-157.230.54.46}"
USER_NAME="${DEPLOY_USER:-root}"
REMOTE_DIR="${DEPLOY_REMOTE_DIR:-/root/trading-server}"
FLEET_SERVICE="${DEPLOY_FLEET_SERVICE:-trading-fleet-live.service}"
MISSION_SERVICE="${DEPLOY_MISSION_SERVICE:-mission-control.service}"
SOURCE_REPOSITORY="${DEPLOY_SOURCE_REPOSITORY:-$(basename "$(pwd)")}"
CLEAN_SOURCE=""
SOURCE_PARENT=""
LOCAL_RELEASE_DIR=""

RUNTIME_FILES=(
  "alpaca_trader.py"
  "broker_protection.py"
  "execution_engine.py"
  "exit_plan.py"
  "fleet_runner.py"
  "mission_control_telemetry.py"
  "monitoring_app.py"
  "renko_builder.py"
  "reversal_protection.py"
  "strategy_engine.py"
  "trading_events.py"
  "requirements.txt"
)
PACKAGE_DIRS=(
  "shared"
  "silver"
)
SERVICE_FILES=(
  "mission-control.service"
  "trading-fleet-live.service"
)
CONFIG_FILE="configs/traders.live.example.json"

EXCLUDED_PATHS=(
  ".git/"
  ".env"
  "venv/"
  ".venv/"
  "__pycache__/"
  ".pytest_cache/"
  "artifacts/"
  "data/"
  "docs/"
  "replay/"
  "tests/"
  "*.log"
  "*.patch"
  "*.diff"
)

COMMIT_ARG=""
ROLLBACK_ID=""
ROLLBACK_REQUESTED=0
DRY_RUN=0
DEPLOY_CONFIG=0
RESTART_FLEET=0
RESTART_MISSION=0
DEPLOY_SERVICES=0

usage() {
  cat <<'EOF'
Usage:
  ./deploy-trading --commit <sha> --dry-run [--deploy-config]
  ./deploy-trading --commit <sha> --no-restart [--deploy-config]
  ./deploy-trading --restart-fleet
  ./deploy-trading --rollback <deployment-id> [--restart-fleet]

Options:
  --commit <sha>             Git commit to deploy from an extracted clean archive.
  --dry-run                  Show planned payload and validation without remote changes.
  --no-restart               Deploy code without restarting services.
  --deploy-config            Replace remote production config from the requested commit.
  --deploy-services          Replace remote systemd service unit files.
  --restart-fleet            Restart only trading-fleet-live.service.
  --restart-mission-control  Restart only mission-control.service.
  --rollback <deployment-id> Restore files from /root/deploy-backups/<deployment-id>.
  --host <host>              Override deploy host.
  --user <user>              Override deploy user.
  --remote-dir <path>        Override remote directory.
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

quote() {
  printf "%q" "$1"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --commit)
        [[ $# -ge 2 ]] || die "--commit requires a value"
        COMMIT_ARG="$2"
        shift 2
        ;;
      --rollback)
        [[ $# -ge 2 ]] || die "--rollback requires a deployment ID"
        ROLLBACK_ID="$2"
        ROLLBACK_REQUESTED=1
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --no-restart)
        shift
        ;;
      --deploy-config)
        DEPLOY_CONFIG=1
        shift
        ;;
      --deploy-services)
        DEPLOY_SERVICES=1
        shift
        ;;
      --restart-fleet)
        RESTART_FLEET=1
        shift
        ;;
      --restart-mission-control)
        RESTART_MISSION=1
        shift
        ;;
      --host)
        [[ $# -ge 2 ]] || die "--host requires a value"
        HOST="$2"
        shift 2
        ;;
      --user)
        [[ $# -ge 2 ]] || die "--user requires a value"
        USER_NAME="$2"
        shift 2
        ;;
      --remote-dir)
        [[ $# -ge 2 ]] || die "--remote-dir requires a value"
        REMOTE_DIR="$2"
        shift 2
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
  done
}

warn_if_dirty_worktree() {
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "NOTICE: caller working tree is dirty; deployment payload will still come only from the requested clean commit." >&2
  fi
}

validate_deployment_id() {
  local value="$1"
  if [[ ! "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]; then
    die "invalid deployment ID: ${value:-<empty>}"
  fi
  case "$value" in
    "."|".."|*/*|*\\*)
      die "invalid deployment ID: ${value:-<empty>}"
      ;;
  esac
}

validate_remote_dir() {
  [[ "$REMOTE_DIR" == /* ]] || die "--remote-dir must be an absolute POSIX path"
  case "$REMOTE_DIR" in
    *$'\n'*|*$'\r'*|*$'\t'*|*"'"*|*'"'*|*'\'*|*'`'*|*'$'*|*';'*|*'&'*|*'|'*|*'<'*|*'>'*|*'('*|*')'*|*'{'*|*'}'*)
      die "--remote-dir contains unsafe characters"
      ;;
  esac
}

resolve_commit() {
  local requested="$1"
  [[ -n "$requested" ]] || die "--commit is required for deployment"
  git rev-parse --verify "${requested}^{commit}" 2>/dev/null || die "invalid commit: ${requested}"
}

sha256_file() {
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    sha256sum "$1" | awk '{print $1}'
  fi
}

create_clean_commit_source() {
  local commit="$1"
  SOURCE_PARENT="$(mktemp -d "${TMPDIR:-/tmp}/deploy-trading.XXXXXX")"
  CLEAN_SOURCE="${SOURCE_PARENT}/source"
  mkdir -p "$CLEAN_SOURCE"
  git archive --format=tar "$commit" | tar -x -f - -C "$CLEAN_SOURCE"
  [[ -f "${CLEAN_SOURCE}/deploy-trading" ]] || die "commit archive extraction did not produce expected repository files"
}

cleanup_commit_source() {
  if [[ -n "${SOURCE_PARENT:-}" && -d "$SOURCE_PARENT" ]]; then
    rm -rf "$SOURCE_PARENT"
  fi
}

cleanup_local_resources() {
  if [[ -n "${LOCAL_RELEASE_DIR:-}" && -d "$LOCAL_RELEASE_DIR" ]]; then
    rm -rf "$LOCAL_RELEASE_DIR"
  fi
}

cleanup_all() {
  cleanup_commit_source
  cleanup_local_resources
}

require_payload_exists() {
  local source_dir="$1"
  local path
  for path in "${RUNTIME_FILES[@]}" "${PACKAGE_DIRS[@]}"; do
    [[ -e "${source_dir}/${path}" ]] || die "required payload path missing from commit source: ${path}"
  done
  if [[ "$DEPLOY_SERVICES" == "1" ]]; then
    for path in "${SERVICE_FILES[@]}"; do
      [[ -e "${source_dir}/${path}" ]] || die "required service file missing from commit source: ${path}"
    done
  fi
  if [[ "$DEPLOY_CONFIG" == "1" ]]; then
    [[ -f "${source_dir}/${CONFIG_FILE}" ]] || die "requested config is missing from commit source: ${CONFIG_FILE}"
  fi
}

print_payload() {
  local path
  echo "Payload includes:"
  for path in "${RUNTIME_FILES[@]}" "${PACKAGE_DIRS[@]}"; do
    echo "  ${path}"
  done
  if [[ "$DEPLOY_SERVICES" == "1" ]]; then
    for path in "${SERVICE_FILES[@]}"; do
      echo "  ${path}"
    done
  else
    echo "  service files preserved remotely (use --deploy-services to replace)"
  fi
  if [[ "$DEPLOY_CONFIG" == "1" ]]; then
    echo "  ${CONFIG_FILE}"
  fi
  echo
  echo "Payload excludes:"
  for path in "${EXCLUDED_PATHS[@]}"; do
    echo "  ${path}"
  done
  echo "  validated_renko_backtest.cpp (not required by fleet_runner.py, services, or runtime imports)"
  echo
}

print_payload_hashes() {
  local source_dir="$1"
  local path
  echo "Payload source hashes from resolved commit:"
  for path in "${RUNTIME_FILES[@]}"; do
    echo "  ${path} $(sha256_file "${source_dir}/${path}")"
  done
  if [[ "$DEPLOY_SERVICES" == "1" ]]; then
    for path in "${SERVICE_FILES[@]}"; do
      echo "  ${path} $(sha256_file "${source_dir}/${path}")"
    done
  fi
  for path in "${PACKAGE_DIRS[@]}"; do
    (
      cd "$source_dir"
      find "$path" -type f -print | LC_ALL=C sort | while read -r file; do
        printf '%s  %s\n' "$(sha256_file "$file")" "$file"
      done | sha256_file /dev/stdin
    ) | awk -v p="$path" '{print "  " p "/ " $1}'
  done
  if [[ "$DEPLOY_CONFIG" == "1" ]]; then
    echo "  ${CONFIG_FILE} $(sha256_file "${source_dir}/${CONFIG_FILE}")"
  fi
  echo
}

deployment_id_for() {
  local commit="$1"
  python3 - "$commit" "$$" <<'PY'
import sys
from datetime import datetime, timezone
commit = sys.argv[1]
pid = int(sys.argv[2])
stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
print(f"{stamp}-{commit[:12]}-{pid:x}")
PY
}

remote_target() {
  echo "${USER_NAME}@${HOST}"
}

ssh_base() {
  ssh -o ControlMaster=auto -o ControlPersist=600 -o ControlPath="/tmp/deploy-trading-%r@%h:%p" "$@"
}

scp_base() {
  scp -o ControlMaster=auto -o ControlPersist=600 -o ControlPath="/tmp/deploy-trading-%r@%h:%p" "$@"
}

dry_run_commit() {
  local commit="$1"
  local deployment_id="$2"
  local config_policy="preserve_remote"
  [[ "$DEPLOY_CONFIG" == "1" ]] && config_policy="replace_from_commit"

  cat <<EOF
DRY RUN ONLY - no SSH, SCP, remote filesystem, service, or network changes will be made.
Requested commit: ${COMMIT_ARG}
Resolved commit: ${commit}
Source materialization: git archive
Extracted source path: ${CLEAN_SOURCE}
Commit source verification: required files present
Dirty caller worktree: $(if [[ -n "$(git status --porcelain)" ]]; then echo "yes - ignored for payload"; else echo "no"; fi)
Remote destination: $(remote_target):${REMOTE_DIR}
Deployment ID: ${deployment_id}
Remote staging directory: ${REMOTE_DIR}/.deploy-staging/${deployment_id}
Remote backup directory: /root/deploy-backups/${deployment_id}
Config policy: ${config_policy}
Service file policy: $(if [[ "$DEPLOY_SERVICES" == "1" ]]; then echo "replace_from_commit"; else echo "preserve_remote"; fi)
Config path used by service: ${REMOTE_DIR}/configs/traders.live.example.json
Services restarted by this command: none

EOF
  print_payload
  print_payload_hashes "$CLEAN_SOURCE"
  cat <<EOF
Validation commands:
  cd ${REMOTE_DIR}/.deploy-staging/${deployment_id}
  source ${REMOTE_DIR}/venv/bin/activate
  python -m py_compile alpaca_trader.py trading_events.py renko_builder.py strategy_engine.py execution_engine.py fleet_runner.py mission_control_telemetry.py monitoring_app.py
  python -c 'import shared.config.trader_config; import silver.market.one_second_sampler; import silver.evidence.logger; import silver.evidence.shadow_sampler; import fleet_runner'
  python - /path/to/config.json <<'PY'  # fixed Python source; config path passed as argv in real validation
  import json
  import sys
  from pathlib import Path
  from shared.config.trader_config import build_strategy_config, validate_single_strategy_kernel_config
  data = json.loads(Path(sys.argv[1]).read_text())
  for trader in data.get("traders", []):
      if isinstance(trader, dict) and trader.get("enabled", False):
          build_strategy_config(trader)
  validate_single_strategy_kernel_config(data, config_path=sys.argv[1])
  print("enabled trader config validation OK")
  PY
  python fleet_runner.py --help

Proof of commit-source isolation:
  payload source is the extracted clean commit archive at ${CLEAN_SOURCE}
  caller working tree files are not copied
  unstaged local fleet_runner.py/renko_builder.py/config/validated_renko_backtest.cpp changes are excluded unless present in ${commit}
  fleet_runner.py hash above is from the clean commit source, not the caller working tree
EOF
}

make_local_release() {
  local source_dir="$1"
  local release_dir="$2"
  mkdir -p "$release_dir"
  local path
  for path in "${RUNTIME_FILES[@]}"; do
    install -m 0644 "${source_dir}/${path}" "${release_dir}/${path}"
  done
  for path in "${PACKAGE_DIRS[@]}"; do
    cp -a "${source_dir}/${path}" "${release_dir}/${path}"
  done
  if [[ "$DEPLOY_SERVICES" == "1" ]]; then
    for path in "${SERVICE_FILES[@]}"; do
      install -m 0644 "${source_dir}/${path}" "${release_dir}/${path}"
    done
  fi
  if [[ "$DEPLOY_CONFIG" == "1" ]]; then
    mkdir -p "${release_dir}/configs"
    install -m 0644 "${source_dir}/${CONFIG_FILE}" "${release_dir}/${CONFIG_FILE}"
  fi
}

remote_validation_script() {
  local staging_dir="$1"
  local config_path="$2"
  cat <<EOF
set -euo pipefail
cd $(quote "$staging_dir")
test -f fleet_runner.py
test -d shared
test -d silver
test -f requirements.txt
source $(quote "$REMOTE_DIR")/venv/bin/activate
python -m py_compile alpaca_trader.py trading_events.py renko_builder.py strategy_engine.py execution_engine.py fleet_runner.py mission_control_telemetry.py monitoring_app.py
python - <<'PY'
import shared.config.trader_config
import silver.market.one_second_sampler
import silver.evidence.logger
import silver.evidence.shadow_sampler
import fleet_runner
PY
python - "$config_path" <<'PY'
import json
import sys
from pathlib import Path
from shared.config.trader_config import build_strategy_config, validate_single_strategy_kernel_config
config_path = Path(sys.argv[1])
data = json.loads(config_path.read_text())
for trader in data.get("traders", []):
    if isinstance(trader, dict) and trader.get("enabled", False):
        build_strategy_config(trader)
validate_single_strategy_kernel_config(data, config_path=str(config_path))
print("enabled trader config validation OK")
PY
python fleet_runner.py --help >/dev/null
EOF
}

deploy_commit() {
  local commit="$1"
  local deployment_id="$2"
  local target staging_dir backup_dir manifest_file config_policy config_hash requirements_hash
  target="$(remote_target)"
  staging_dir="${REMOTE_DIR}/.deploy-staging/${deployment_id}"
  backup_dir="/root/deploy-backups/${deployment_id}"
  LOCAL_RELEASE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/deploy-release.XXXXXX")"
  manifest_file="${LOCAL_RELEASE_DIR}/DEPLOYED_VERSION.json"
  config_policy="preserve_remote"
  [[ "$DEPLOY_CONFIG" == "1" ]] && config_policy="replace_from_commit"
  requirements_hash="$(sha256_file "${CLEAN_SOURCE}/requirements.txt")"
  config_hash=""
  if [[ "$DEPLOY_CONFIG" == "1" ]]; then
    config_hash="$(sha256_file "${CLEAN_SOURCE}/${CONFIG_FILE}")"
  fi

  make_local_release "$CLEAN_SOURCE" "$LOCAL_RELEASE_DIR"

  python3 - "$manifest_file" "$deployment_id" "$commit" "$SOURCE_REPOSITORY" "$requirements_hash" "$config_policy" "$config_hash" "$backup_dir" "$DEPLOY_CONFIG" "$DEPLOY_SERVICES" "${RUNTIME_FILES[@]}" --packages "${PACKAGE_DIRS[@]}" --services "${SERVICE_FILES[@]}" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone
manifest_path = sys.argv[1]
deployment_id = sys.argv[2]
commit = sys.argv[3]
source_repository = sys.argv[4]
requirements_hash = sys.argv[5]
config_policy = sys.argv[6]
config_hash = sys.argv[7] or None
backup_dir = sys.argv[8]
deploy_config = bool(int(sys.argv[9]))
deploy_services = bool(int(sys.argv[10]))
packages_separator = sys.argv.index("--packages", 11)
services_separator = sys.argv.index("--services", packages_separator + 1)
runtime_files = sys.argv[11:packages_separator]
package_dirs = sys.argv[packages_separator + 1:services_separator]
service_files = sys.argv[services_separator + 1:]
manifest = {
    "deployment_id": os.environ.get("DEPLOY_TEST_MANIFEST_DEPLOYMENT_ID_OVERRIDE", deployment_id),
    "git_commit": os.environ.get("DEPLOY_TEST_MANIFEST_COMMIT_OVERRIDE", commit),
    "deployed_at": datetime.now(timezone.utc).isoformat(),
    "source_repository": source_repository,
    "payload_groups": {
        "runtime_files": runtime_files,
        "package_dirs": package_dirs,
        "service_files": service_files if deploy_services else [],
        "service_files_deployed": deploy_services,
        "config_deployed": deploy_config,
        "validated_renko_backtest_cpp": "excluded_not_runtime_required",
    },
    "requirements_hash": requirements_hash,
    "config_policy": config_policy,
    "config_hash": config_hash,
    "backup_id": deployment_id,
    "backup_path": backup_dir,
    "validation_status": os.environ.get("DEPLOY_TEST_MANIFEST_STATUS_OVERRIDE", "generated"),
    "fleet_restart_status": "not_requested",
    "mission_control_restart_status": "not_requested",
}
with open(manifest_path, "w", encoding="utf-8") as handle:
    json.dump(manifest, handle, indent=2, sort_keys=True)
    handle.write("\n")
    if os.environ.get("DEPLOY_TEST_LITERAL_MANIFEST_SUFFIX") == "1":
        handle.write("\\n")
PY
  validate_local_manifest "$manifest_file" "$deployment_id" "$commit" "generated"

  echo "Uploading release ${deployment_id} to ${target}:${staging_dir}"
  ssh_base "$target" "rm -rf $(quote "$staging_dir") && mkdir -p $(quote "$staging_dir") $(quote "$backup_dir")"
  scp_base -r "${LOCAL_RELEASE_DIR}/." "${target}:${staging_dir}/"

  local validation_config="${REMOTE_DIR}/configs/traders.live.example.json"
  if [[ "$DEPLOY_CONFIG" == "1" ]]; then
    validation_config="${staging_dir}/${CONFIG_FILE}"
  fi

  echo "Validating staged release without live execution"
  ssh_base "$target" "bash -lc $(quote "$(remote_validation_script "$staging_dir" "$validation_config")")"

  echo "Validating deployment manifest before promotion"
  ssh_base "$target" "bash -lc $(quote "$(remote_mark_manifest_validated_script "$deployment_id" "$commit" "${staging_dir}/DEPLOYED_VERSION.json")")"

  echo "Backing up replaced runtime files to ${backup_dir}"
  ssh_base "$target" "bash -lc $(quote "$(remote_backup_script "$deployment_id" "$commit" "$backup_dir")")"

  echo "Promoting staged runtime files"
  ssh_base "$target" "bash -lc $(quote "$(remote_promote_script "$deployment_id" "$staging_dir")")"

  echo "Writing deployment manifest"
  if ! ssh_base "$target" "bash -lc $(quote "$(remote_install_manifest_script "$deployment_id" "$commit" "${staging_dir}/DEPLOYED_VERSION.json" "${REMOTE_DIR}/DEPLOYED_VERSION.json")")"; then
    echo "INCOMPLETE_DEPLOYMENT: runtime promotion completed but DEPLOYED_VERSION.json was not installed." >&2
    echo "INCOMPLETE_DEPLOYMENT deployment_id=${deployment_id}" >&2
    echo "Recovery options: rerun the same commit with --no-restart after fixing deployment, or rollback ${deployment_id} without restart after separate approval." >&2
    return 1
  fi

  echo "Cleaning promoted old runtime siblings after durable manifest"
  ssh_base "$target" "bash -lc $(quote "$(remote_cleanup_old_script "$deployment_id")")"

  cleanup_local_resources
  echo "Deploy complete without service restart. Use ./deploy-trading --restart-fleet after separate approval."
}

validate_local_manifest() {
  local manifest_file="$1"
  local deployment_id="$2"
  local commit="$3"
  local expected_status="$4"
  python3 - "$manifest_file" "$deployment_id" "$commit" "$expected_status" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
deployment_id = sys.argv[2]
commit = sys.argv[3]
expected_status = sys.argv[4]

with path.open("r", encoding="utf-8") as handle:
    data = json.load(handle)

required = {
    "deployment_id",
    "git_commit",
    "deployed_at",
    "source_repository",
    "payload_groups",
    "requirements_hash",
    "config_policy",
    "backup_id",
    "backup_path",
    "validation_status",
}
missing = sorted(required.difference(data))
if missing:
    raise SystemExit(f"manifest missing required fields: {missing}")
if data["deployment_id"] != deployment_id:
    raise SystemExit("manifest deployment_id mismatch")
if data["git_commit"] != commit:
    raise SystemExit("manifest git_commit mismatch")
if data["validation_status"] != expected_status:
    raise SystemExit("manifest validation_status mismatch")
PY
}

remote_manifest_python() {
  cat <<'PY'
import json
import os
import sys
from pathlib import Path

REQUIRED = {
    "deployment_id",
    "git_commit",
    "deployed_at",
    "source_repository",
    "payload_groups",
    "requirements_hash",
    "config_policy",
    "backup_id",
    "backup_path",
    "validation_status",
}

def load_manifest(path: Path) -> dict:
    text = path.read_text(encoding="utf-8")
    data = json.loads(text)
    missing = sorted(REQUIRED.difference(data))
    if missing:
        raise SystemExit(f"manifest missing required fields: {missing}")
    return data

def write_manifest(path: Path, data: dict) -> None:
    tmp = path.with_name(f"{path.name}.__tmp__.{data['deployment_id']}")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    reparsed = load_manifest(tmp)
    if reparsed != data:
        raise SystemExit("manifest write verification mismatch")
    os.replace(tmp, path)

mode = sys.argv[1]
deployment_id = sys.argv[2]
commit = sys.argv[3]

if mode == "mark_validated":
    manifest_path = Path(sys.argv[4])
    data = load_manifest(manifest_path)
    if data["deployment_id"] != deployment_id:
        raise SystemExit("manifest deployment_id mismatch")
    if data["git_commit"] != commit:
        raise SystemExit("manifest git_commit mismatch")
    if data["validation_status"] not in {"generated", "passed"}:
        raise SystemExit("manifest validation_status is not pre-promotion successful")
    data["validation_status"] = "passed"
    write_manifest(manifest_path, data)
elif mode == "install_passed":
    staged_manifest = Path(sys.argv[4])
    final_manifest = Path(sys.argv[5])
    data = load_manifest(staged_manifest)
    if data["deployment_id"] != deployment_id:
        raise SystemExit("manifest deployment_id mismatch")
    if data["git_commit"] != commit:
        raise SystemExit("manifest git_commit mismatch")
    if data["validation_status"] != "passed":
        raise SystemExit("manifest was not validated before promotion")
    final_manifest.parent.mkdir(parents=True, exist_ok=True)
    write_manifest(final_manifest, data)
    (final_manifest.parent / ".last_successful_deployment_id").write_text(deployment_id + "\n", encoding="utf-8")
    (final_manifest.parent / ".last_deployment_id").write_text(deployment_id + "\n", encoding="utf-8")
else:
    raise SystemExit(f"unknown manifest mode: {mode}")
PY
}

remote_mark_manifest_validated_script() {
  local deployment_id="$1"
  local commit="$2"
  local manifest_path="$3"
  cat <<EOF
set -euo pipefail
python3 - mark_validated $(quote "$deployment_id") $(quote "$commit") $(quote "$manifest_path") <<'PY'
$(remote_manifest_python)
PY
EOF
}

remote_install_manifest_script() {
  local deployment_id="$1"
  local commit="$2"
  local staged_manifest="$3"
  local final_manifest="$4"
  cat <<EOF
set -euo pipefail
if [[ "\${DEPLOY_TEST_FAIL_FINAL_MANIFEST_WRITE:-0}" == "1" ]]; then
  exit 45
fi
python3 - install_passed $(quote "$deployment_id") $(quote "$commit") $(quote "$staged_manifest") $(quote "$final_manifest") <<'PY'
$(remote_manifest_python)
PY
EOF
}

remote_backup_script() {
  local deployment_id="$1"
  local requested_commit="$2"
  local backup_dir="$3"
  cat <<EOF
set -euo pipefail
cd $(quote "$REMOTE_DIR")
mkdir -p $(quote "$backup_dir") $(quote "$backup_dir")/configs
files=(${RUNTIME_FILES[*]@Q})
dirs=(${PACKAGE_DIRS[*]@Q})
service_files=()
if [[ "$DEPLOY_SERVICES" == "1" ]]; then
  service_files=(${SERVICE_FILES[*]@Q})
fi
backed_up=()
for f in "\${files[@]}"; do
  if [[ -e "\$f" ]]; then
    cp -a "\$f" $(quote "$backup_dir")/
    backed_up+=("\$f")
  fi
done
