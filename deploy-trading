restart_fleet_only() {
  local target pre_restart_gate post_activation_gate restart_script
  target="$(remote_target)"
  if [[ "$DRY_RUN" == "1" ]]; then
    echo "DRY RUN ONLY - would restart ${FLEET_SERVICE} on ${target}"
    return
  fi
  pre_restart_gate="$(remote_activation_gate_script pre_restart "${REMOTE_DIR}/${STANDARD_CONFIG_FILE}" "${REMOTE_DIR}/${STANDARD_CONFIG_FILE}" "${REMOTE_DIR}/${MARKET_CONFIG_FILE}" "${REMOTE_DIR}/DEPLOYED_VERSION.json")"
  post_activation_gate="$(remote_activation_gate_script post_activation "${REMOTE_DIR}/${STANDARD_CONFIG_FILE}" "${REMOTE_DIR}/${STANDARD_CONFIG_FILE}" "${REMOTE_DIR}/${MARKET_CONFIG_FILE}" "${REMOTE_DIR}/DEPLOYED_VERSION.json")"
  restart_script="${pre_restart_gate}
systemctl restart $(quote "$FLEET_SERVICE")
systemctl is-active $(quote "$FLEET_SERVICE")
if ! (
${post_activation_gate}
); then
  systemctl stop $(quote "$FLEET_SERVICE")
  exit 42
fi"
  if ! ssh_base "$target" "bash -lc $(quote "$restart_script")"; then
    die "fleet pre-restart, restart, or post-activation gate failed"
  fi
}

restart_mission_only() {
