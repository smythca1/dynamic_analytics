remote_target() {
  echo "${USER_NAME}@${HOST}"
}

ssh_base() {
  ssh -o ControlMaster=auto -o ControlPersist=600 -o ControlPath="/tmp/deploy-trading-%r@%h:%p" "$@"
}

scp_base() {
  scp -o ControlMaster=auto -o ControlPersist=600 -o ControlPath="/tmp/deploy-trading-%r@%h:%p" "$@"
}

dry_run_commit() {
  local commit="$1"
  local deployment_id="$2"
  local config_policy="preserve_remote"
  [[ "$DEPLOY_CONFIG" == "1" ]] && config_policy="replace_from_commit"

  cat <<EOF
DRY RUN ONLY - no SSH, SCP, remote filesystem, service, or network changes will be made.
Requested commit: ${COMMIT_ARG}
Resolved commit: ${commit}
Source materialization: git archive
Extracted source path: ${CLEAN_SOURCE}
Commit source verification: required files present
Dirty caller worktree: $(if [[ -n "$(git status --porcelain)" ]]; then echo "yes - ignored for payload"; else echo "no"; fi)
Remote destination: $(remote_target):${REMOTE_DIR}
Deployment ID: ${deployment_id}
Remote staging directory: ${REMOTE_DIR}/.deploy-staging/${deployment_id}
Remote backup directory: /root/deploy-backups/${deployment_id}
Config policy: ${config_policy}
Service file policy: $(if [[ "$DEPLOY_SERVICES" == "1" ]]; then echo "replace_from_commit"; else echo "preserve_remote"; fi)
Config path used by service: ${REMOTE_DIR}/${CONFIG_FILE}
Services restarted by this command: none
Activation gates: broker and checkpoint gates required; not evaluated in dry-run
Live activation status: blocked pending authenticated broker and runtime checkpoint evidence

EOF
  print_payload
  print_payload_hashes "$CLEAN_SOURCE"
  cat <<EOF
Validation commands:
  cd ${REMOTE_DIR}/.deploy-staging/${deployment_id}
  source ${REMOTE_DIR}/venv/bin/activate
  python -m py_compile alpaca_trader.py trading_events.py renko_builder.py strategy_engine.py execution_engine.py fleet_runner.py mission_control_telemetry.py monitoring_app.py
  python -c 'import shared.config.trader_config; import silver.market.one_second_sampler; import silver.evidence.logger; import silver.evidence.shadow_sampler; import fleet_runner'
  python - /path/to/config.json <<'PY'  # fixed Python source; config path passed as argv in real validation
  import json
  import sys
  from pathlib import Path
  from shared.config.trader_config import build_strategy_config, validate_production_fleet_config
  data = json.loads(Path(sys.argv[1]).read_text())
  for trader in data.get("traders", []):
      if isinstance(trader, dict) and trader.get("enabled", False):
          build_strategy_config(trader)
  validate_production_fleet_config(data, config_path=sys.argv[1])
  print("enabled trader config validation OK")
  PY
  python fleet_runner.py --help

Proof of commit-source isolation:
  payload source is the extracted clean commit archive at ${CLEAN_SOURCE}
  caller working tree files are not copied
  unstaged local fleet_runner.py/renko_builder.py/config/validated_renko_backtest.cpp changes are excluded unless present in ${commit}
  fleet_runner.py hash above is from the clean commit source, not the caller working tree
EOF
}

make_local_release() {
  local source_dir="$1"
  local release_dir="$2"
  mkdir -p "$release_dir"
  local path
  for path in "${RUNTIME_FILES[@]}"; do
    install -m 0644 "${source_dir}/${path}" "${release_dir}/${path}"
  done
  for path in "${PACKAGE_DIRS[@]}"; do
    cp -a "${source_dir}/${path}" "${release_dir}/${path}"
  done
  if [[ "$DEPLOY_SERVICES" == "1" ]]; then
    for path in "${SERVICE_FILES[@]}"; do
      install -m 0644 "${source_dir}/${path}" "${release_dir}/${path}"
    done
  fi
  if [[ "$DEPLOY_CONFIG" == "1" ]]; then
    mkdir -p "${release_dir}/$(dirname "$CONFIG_FILE")"
    install -m 0644 "${source_dir}/${CONFIG_FILE}" "${release_dir}/${CONFIG_FILE}"
  fi
  if [[ "$DEPLOY_CONFIG" == "1" && -n "$EXTRA_CONFIG_FILE" ]]; then
    mkdir -p "${release_dir}/$(dirname "$EXTRA_CONFIG_FILE")"
    install -m 0644 "${source_dir}/${EXTRA_CONFIG_FILE}" "${release_dir}/${EXTRA_CONFIG_FILE}"
  fi
}

remote_validation_script() {
  local release_commit="$1"
  local staging_dir="$2"
  local shared_config_path="$3"
  local release_commit_literal
  release_commit_literal="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$release_commit")"
  shift 3
  local fleet_config_paths=("$@")
  local quoted_fleet_paths=""
  local fleet_config_path
  for fleet_config_path in "${fleet_config_paths[@]}"; do
    quoted_fleet_paths+=" $(quote "$fleet_config_path")"
  done
  cat <<EOF
set -euo pipefail
cd $(quote "$staging_dir")
test -f fleet_runner.py
test -d shared
test -d silver
test -f requirements.txt
source $(quote "$REMOTE_DIR")/venv/bin/activate
python -m py_compile alpaca_trader.py trading_events.py renko_builder.py strategy_engine.py execution_engine.py fleet_runner.py mission_control_telemetry.py monitoring_app.py
python - <<'PY'
import shared.config.trader_config
import silver.market.one_second_sampler
import silver.evidence.logger
import silver.evidence.shadow_sampler
import fleet_runner
PY
python - "$shared_config_path"${quoted_fleet_paths} <<'PY'
import json
import sys
from pathlib import Path
from shared.config.trader_config import build_strategy_config, validate_production_fleet_config
from silver.market.shared_service import SharedMarketDataConfig, validate_shared_market_data_config
from shared.deployment.release_contract import build_release_contract

shared_config_path = Path(sys.argv[1])
fleet_configs = []
for raw_path in sys.argv[2:]:
    config_path = Path(raw_path)
    if not config_path.is_file():
        raise ValueError(f"production fleet config is missing: {config_path}")
    data = json.loads(config_path.read_text(encoding="utf-8"))
    enabled_traders = [
        trader for trader in data.get("traders", [])
        if isinstance(trader, dict) and trader.get("enabled", False)
    ]
    for trader in enabled_traders:
        build_strategy_config(trader)
    if enabled_traders:
        validate_production_fleet_config(data, config_path=str(config_path))
    fleet_configs.append(data)

if not shared_config_path.is_file():
    raise ValueError(f"shared market-data config is missing: {shared_config_path}")
shared_config = SharedMarketDataConfig.load(shared_config_path)
validate_shared_market_data_config(shared_config, fleet_configs)
combined = {"traders": []}
for fleet in fleet_configs:
    combined["traders"].extend(fleet.get("traders", []))
contract = build_release_contract(
    commit=${release_commit_literal},
    config_paths=[shared_config_path, *[Path(raw_path) for raw_path in sys.argv[2:]]],
    trader_config=combined,
    market_config=json.loads(shared_config_path.read_text(encoding="utf-8")),
    service_dependencies={"trading-fleet-live.service": [str(path) for path in sys.argv[2:]]},
)
print(json.dumps({"release_contract": contract}, sort_keys=True))
print("shared market-data deployment preflight OK")
PY
python fleet_runner.py --help >/dev/null
EOF
}

remote_activation_gate_script() {
  local mode="$1"
  local baseline_config="$2"
  local candidate_config="$3"
  local market_config="$4"
  local manifest_path="$5"
  local candidate_root
  candidate_root="$(dirname "$(dirname "$candidate_config")")"
  cat <<EOF
set -euo pipefail
cd $(quote "$REMOTE_DIR")
if [[ -f .env ]]; then set -a; . ./.env; set +a; fi
source $(quote "$REMOTE_DIR")/venv/bin/activate
if [[ -f $(quote "$candidate_root")/shared/deployment/release_contract.py ]]; then
  export PYTHONPATH=$(quote "$candidate_root")\${PYTHONPATH:+:\${PYTHONPATH}}
fi
python - $(quote "$mode") $(quote "$baseline_config") $(quote "$candidate_config") $(quote "$market_config") $(quote "$manifest_path") <<'PY'
import json
import hashlib
import os
import sys
from datetime import datetime, timezone
from pathlib import Path
from alpaca_trader import AlpacaTrader, load_alpaca_credentials

mode, baseline_path, candidate_path, market_path, manifest_path = sys.argv[1:]
candidate_root = Path(candidate_path).resolve().parent.parent
sys.path.insert(0, str(candidate_root))
import shared.deployment.release_contract as release_contract_module
from shared.deployment.release_contract import evaluate_broker_snapshot, evaluate_checkpoint_snapshot, validate_historical_checkpoint_authorizations
release_contract_path = Path(release_contract_module.__file__).resolve()
try:
    release_contract_path.relative_to(candidate_root)
except ValueError as exc:
    raise RuntimeError(f"release-contract module is outside candidate root: {release_contract_path}") from exc
out = {"evaluated_at_utc": datetime.now(timezone.utc).isoformat(), "mode": mode, "broker": "not_evaluated", "checkpoint": "not_evaluated"}
expected_account = os.environ.get("DEPLOY_EXPECTED_ACCOUNT_ID")
if not expected_account:
    out["error"] = "DEPLOY_EXPECTED_ACCOUNT_ID is required for activation safety"
    print(json.dumps(out, sort_keys=True))
    raise SystemExit(42)

baseline = json.loads(Path(baseline_path).read_text(encoding="utf-8")) if Path(baseline_path).is_file() else {"traders": []}
candidate = json.loads(Path(candidate_path).read_text(encoding="utf-8"))
manifest = json.loads(Path(manifest_path).read_text(encoding="utf-8"))
historical_authorizations = manifest.get("historical_checkpoint_authorizations", [])
if not isinstance(historical_authorizations, list):
    out["checkpoint"] = {"status": "BLOCKED", "errors": ["historical_checkpoint_authorizations must be a list"]}
    print(json.dumps(out, sort_keys=True))
    raise SystemExit(42)

def enabled(config):
    return [t for t in config.get("traders", []) if isinstance(t, dict) and t.get("enabled")]

def load_authorized_configs(primary):
    configs = [primary]
    for path in (Path("configs/accounts/spxc.live.json"), Path("configs/accounts/megatron.live.json")):
        if path.is_file():
            configs.append(json.loads(path.read_text(encoding="utf-8")))
    return configs

baseline_configs = load_authorized_configs(baseline)
candidate_configs = load_authorized_configs(candidate)
old = {str(t.get("id")): t for config in baseline_configs for t in enabled(config)}
new = {str(t.get("id")): t for config in candidate_configs for t in enabled(config)}
affected = set()
flat_required = set()
for identity in set(old) | set(new):
    if old.get(identity) != new.get(identity):
        for row in (old.get(identity), new.get(identity)):
            if row and row.get("symbol"):
                symbol = str(row["symbol"]).upper()
                affected.add(symbol)
                flat_required.add(symbol)
market = json.loads(Path(market_path).read_text(encoding="utf-8"))
try:
    # Historical evidence never abandons exposure: verify its symbols on every gate.
    historical_symbols = {str(record.get("symbol", "")).upper() for record in historical_authorizations if isinstance(record, dict)} - {""}
    affected.update(historical_symbols)
    flat_required.update(historical_symbols)
    trader = AlpacaTrader(load_alpaca_credentials("live"), max_notional=1_000_000)
    account = trader.get_account()
    positions = trader.get_positions()
    orders = trader.get_open_orders_nested(500)
    if not isinstance(account, dict) or account.get("status") != "ACTIVE" or account.get("trading_blocked") is not False or account.get("account_blocked") is not False:
        raise ValueError("broker account health is not confirmed")
    if not isinstance(positions, list) or not isinstance(orders, list) or len(orders) >= 500:
        raise ValueError("incomplete broker positions or open orders")
    if any(not isinstance(row, dict) or not row.get("symbol") or row.get("qty") is None for row in positions):
        raise ValueError("malformed broker position response")
    def flatten_orders(rows):
        result = []
        for row in rows:
            if not isinstance(row, dict) or not row.get("symbol"):
                raise ValueError("malformed broker order response")
            result.append(row)
            legs = row.get("legs")
            if legs is not None:
                if not isinstance(legs, list):
                    raise ValueError("malformed nested broker order response")
                result.extend(flatten_orders(legs))
        return result
    orders = flatten_orders(orders)
    snapshot = {
        "account_id": account.get("id"),
        "api_health": "ok",
        "complete": isinstance(positions, list) and isinstance(orders, list),
        "stale": False,
        "positions": positions,
        "open_orders_nested": orders,
    }
    gate = evaluate_broker_snapshot(snapshot, expected_account_id=expected_account, affected_symbols=affected, require_flat_symbols=flat_required)
    out["broker"] = gate
    broker_positions = {str(p.get("symbol", "")).upper(): float(p.get("qty") or 0) for p in positions if isinstance(p, dict)}
    checkpoints = {identity: None for identity in new}
    state_root = Path("artifacts/live/state")
    inventory = []
    runtime_paths_by_identity = {}
    if state_root.is_dir():
        for state_path in sorted(state_root.rglob("*.json")):
            try:
                payload = json.loads(state_path.read_text(encoding="utf-8"))
            except Exception as exc:
                out["checkpoint"] = {"status": "BLOCKED", "errors": [f"malformed checkpoint {state_path}: {exc}"]}
                print(json.dumps(out, sort_keys=True))
                raise SystemExit(42)
            identity = payload.get("trader_id") if isinstance(payload, dict) else None
            if not identity:
                out["checkpoint"] = {"status": "BLOCKED", "errors": [f"checkpoint identity missing: {state_path}"]}
                print(json.dumps(out, sort_keys=True))
                raise SystemExit(42)
            identity = str(identity)
            relative_path = state_path.as_posix()
            digest = hashlib.sha256(state_path.read_bytes()).hexdigest()
            source = payload.get("original_state") if isinstance(payload.get("original_state"), dict) else payload
            engine = source.get("engine") if isinstance(source.get("engine"), dict) else {}
            relative_state_path = state_path.relative_to(state_root).as_posix()
            rejected_evidence = relative_state_path.startswith("rejected/")
            rejection_metadata_valid = (
                rejected_evidence
                and isinstance(payload.get("original_state"), dict)
                and bool(payload["original_state"].get("trader_id"))
                and bool(payload["original_state"].get("reason"))
                and bool(payload["original_state"].get("saved_at"))
            )
            inventory.append({
                "path": relative_path,
                "sha256": digest,
                "trader_id": identity,
                "symbol": str(source.get("symbol") or payload.get("symbol") or "").upper(),
                "strategy_type": str(engine.get("strategy_type") or engine.get("type") or source.get("strategy_type") or ""),
                "strategy_identity": str(engine.get("strategy_name") or engine.get("identity") or source.get("strategy_identity") or ""),
                "artifact_kind": "rejected_evidence" if rejected_evidence else "runtime_checkpoint",
                "rejection_metadata_valid": rejection_metadata_valid,
            })
            if not rejected_evidence:
                if identity in runtime_paths_by_identity:
                    out["checkpoint"] = {"status": "BLOCKED", "errors": [f"multiple top-level checkpoints for {identity}", runtime_paths_by_identity[identity], relative_path]}
                    print(json.dumps(out, sort_keys=True))
                    raise SystemExit(42)
                runtime_paths_by_identity[identity] = relative_path
                checkpoints[identity] = payload
            if identity in new and not rejected_evidence and relative_state_path != f"{identity}.json":
                out["checkpoint"] = {"status": "BLOCKED", "errors": [f"{identity}: checkpoint path is not identity-specific: {state_path.name}"]}
                print(json.dumps(out, sort_keys=True))
                raise SystemExit(42)
    authorization_gate = validate_historical_checkpoint_authorizations(
        historical_authorizations,
        inventory,
        active_trader_ids=set(new),
    )
    if authorization_gate["status"] != "PASS":
        out["checkpoint"] = authorization_gate
        print(json.dumps(out, sort_keys=True))
        raise SystemExit(42)
    authorized_paths = {str(record["checkpoint_path"]) for record in authorization_gate["validated"]}
    unauthorized_artifacts = [
        row for row in inventory
        if row["path"] not in authorized_paths
        and not (row["trader_id"] in new and row["artifact_kind"] == "runtime_checkpoint")
    ]
    if unauthorized_artifacts:
        out["checkpoint"] = {"status": "BLOCKED", "errors": [
            f"checkpoint artifact lacks authorization: {row['trader_id']}:{row['path']}"
            for row in unauthorized_artifacts
        ]}
        print(json.dumps(out, sort_keys=True))
        raise SystemExit(42)
    checkpoints = {
        identity: payload for identity, payload in checkpoints.items()
        if not any(row["trader_id"] == identity and row["path"] in authorized_paths for row in inventory)
    }
    # Active runtime files are restorable state, never historical authorizations.
    # Validate the actual nested runner snapshot before normalizing for the evaluator.
    from types import SimpleNamespace
    from shared.config.trader_config import build_strategy_config
    from silver.market.contract import contract_snapshot
    from fleet_runner import verify_flat_reversal_recovery
    from execution_engine import AlpacaExecutionEngine
    from strategy_engine import RenkoStrategyEngine
    recovery_verified = []
    for identity, payload in list(checkpoints.items()):
        if identity not in new or payload is None:
            continue
        config = build_strategy_config(new[identity])
        engine = payload.get("engine") or {}
        trade = engine.get("trade") or {}
        expected_contract = contract_snapshot(symbol=config.symbol, strategy_config=config, session_timezone=config.timezone)
        if (
            payload.get("trader_id") != identity or payload.get("symbol") != config.symbol
            or payload.get("configured_quantity") != config.qty
            or payload.get("configured_brick_size") != config.brick_size
            or engine.get("trader_id") != identity or engine.get("symbol") != config.symbol
            or engine.get("strategy_name") != config.strategy_name
            or engine.get("strategy_type") != config.strategy_type
            or payload.get("contract_fingerprints") != expected_contract
            or not isinstance(payload.get("sampler_state"), dict)
        ):
            raise ValueError(f"{identity}: incompatible active checkpoint identity or contract")
        position = trade.get("position")
        if position is not None and (not isinstance(position, dict) or position.get("side") not in {"long", "short"}):
            raise ValueError(f"{identity}: invalid active checkpoint position")
        RenkoStrategyEngine(config).restore_snapshot(engine)
        if trade.get("reconciliation_unsafe"):
            if config.strategy_type != "renko_reversal" or config.exit_management != "strategy" or position is not None:
                raise ValueError(f"{identity}: no supported unsafe checkpoint recovery")
            execution = AlpacaExecutionEngine.__new__(AlpacaExecutionEngine)
            execution.trader = trader
            runtime = SimpleNamespace(
                trader_id=identity, symbol=config.symbol, expected_account_id=expected_account,
                execution=execution, engine=SimpleNamespace(config=config), contract_fingerprints=expected_contract,
            )
            verify_flat_reversal_recovery(state_root.parent, runtime, trade)
            recovery_verified.append(identity)
        normalized = dict(payload, quantity=payload["configured_quantity"], position=position)
        if position is not None:
            normalized["position"] = dict(position, qty=abs(float(position["qty"])) * (-1 if position["side"] == "short" else 1))
        checkpoints[identity] = normalized
    checkpoint_gate = evaluate_checkpoint_snapshot(checkpoints, candidate_traders=[
        {"id": str(t.get("id")), "symbol": str(t.get("symbol", "")).upper(), "quantity": (t.get("sizing") or {}).get("qty")}
        for t in new.values()
    ], broker_positions=broker_positions, retired_trader_ids=set(old) - set(new))
    out["checkpoint"] = checkpoint_gate
    out["checkpoint"]["historical_authorizations"] = authorization_gate["validated"]
    out["checkpoint"]["inventory"] = inventory
    out["checkpoint"]["recovery_verified"] = recovery_verified
except Exception as exc:
    out["error"] = f"activation gate unavailable: {type(exc).__name__}: {exc}"
    print(json.dumps(out, sort_keys=True))
    raise SystemExit(42)
print(json.dumps(out, sort_keys=True))
if out["broker"].get("status") != "PASS" or out["checkpoint"].get("status") != "PASS":
    raise SystemExit(42)
PY
EOF
}

deploy_commit() {
  local commit="$1"
  local deployment_id="$2"
  local target staging_dir backup_dir manifest_file config_policy config_hash requirements_hash
  target="$(remote_target)"
  staging_dir="${REMOTE_DIR}/.deploy-staging/${deployment_id}"
  backup_dir="/root/deploy-backups/${deployment_id}"
  LOCAL_RELEASE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/deploy-release.XXXXXX")"
  manifest_file="${LOCAL_RELEASE_DIR}/DEPLOYED_VERSION.json"
  config_policy="preserve_remote"
  [[ "$DEPLOY_CONFIG" == "1" ]] && config_policy="replace_from_commit"
  requirements_hash="$(sha256_file "${CLEAN_SOURCE}/requirements.txt")"
  config_hash=""
  config_hashes="{}"
if [[ "$DEPLOY_CONFIG" == "1" ]]; then
  config_hash="$(sha256_file "${CLEAN_SOURCE}/${CONFIG_FILE}")"
  config_hashes="$(python3 - "${CLEAN_SOURCE}" "$CONFIG_FILE" "$EXTRA_CONFIG_FILE" <<'PY'
import json
import sys
from pathlib import Path
root = Path(sys.argv[1])
paths = [sys.argv[2]] + ([sys.argv[3]] if sys.argv[3] else [])
print(json.dumps({path: __import__('hashlib').sha256((root / path).read_bytes()).hexdigest() for path in paths}, sort_keys=True))
PY
)"
fi

  make_local_release "$CLEAN_SOURCE" "$LOCAL_RELEASE_DIR"

  python3 - "$manifest_file" "$deployment_id" "$commit" "$SOURCE_REPOSITORY" "$requirements_hash" "$config_policy" "$config_hash" "$config_hashes" "$backup_dir" "$DEPLOY_CONFIG" "$DEPLOY_SERVICES" "${RUNTIME_FILES[@]}" --packages "${PACKAGE_DIRS[@]}" --services "${SERVICE_FILES[@]}" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone
manifest_path = sys.argv[1]
deployment_id = sys.argv[2]
commit = sys.argv[3]
source_repository = sys.argv[4]
requirements_hash = sys.argv[5]
config_policy = sys.argv[6]
config_hash = sys.argv[7] or None
config_hashes = json.loads(sys.argv[8])
backup_dir = sys.argv[9]
deploy_config = bool(int(sys.argv[10]))
deploy_services = bool(int(sys.argv[11]))
packages_separator = sys.argv.index("--packages", 12)
services_separator = sys.argv.index("--services", packages_separator + 1)
runtime_files = sys.argv[12:packages_separator]
package_dirs = sys.argv[packages_separator + 1:services_separator]
service_files = sys.argv[services_separator + 1:]
manifest = {
    "deployment_id": os.environ.get("DEPLOY_TEST_MANIFEST_DEPLOYMENT_ID_OVERRIDE", deployment_id),
    "git_commit": os.environ.get("DEPLOY_TEST_MANIFEST_COMMIT_OVERRIDE", commit),
    "deployed_at": datetime.now(timezone.utc).isoformat(),
    "source_repository": source_repository,
    "payload_groups": {
        "runtime_files": runtime_files,
        "package_dirs": package_dirs,
        "service_files": service_files if deploy_services else [],
        "service_files_deployed": deploy_services,
        "config_deployed": deploy_config,
        "validated_renko_backtest_cpp": "excluded_not_runtime_required",
    },
    "requirements_hash": requirements_hash,
    "config_policy": config_policy,
    "config_hash": config_hash,
    "configuration_hashes": config_hashes,
    "backup_id": deployment_id,
    "backup_path": backup_dir,
    "validation_status": os.environ.get("DEPLOY_TEST_MANIFEST_STATUS_OVERRIDE", "generated"),
    "fleet_restart_status": "not_requested",
    "mission_control_restart_status": "not_requested",
}
raw_authorizations = os.environ.get("DEPLOY_HISTORICAL_CHECKPOINT_AUTHORIZATIONS", "[]")
try:
    historical_authorizations = json.loads(raw_authorizations)
except json.JSONDecodeError as exc:
    raise SystemExit(f"DEPLOY_HISTORICAL_CHECKPOINT_AUTHORIZATIONS must be valid JSON: {exc}")
if not isinstance(historical_authorizations, list):
    raise SystemExit("DEPLOY_HISTORICAL_CHECKPOINT_AUTHORIZATIONS must be a JSON list")
manifest["historical_checkpoint_authorizations"] = historical_authorizations
with open(manifest_path, "w", encoding="utf-8") as handle:
    json.dump(manifest, handle, indent=2, sort_keys=True)
    handle.write("\n")
    if os.environ.get("DEPLOY_TEST_LITERAL_MANIFEST_SUFFIX") == "1":
        handle.write("\\n")
PY
  validate_local_manifest "$manifest_file" "$deployment_id" "$commit" "generated"

  echo "Uploading release ${deployment_id} to ${target}:${staging_dir}"
  ssh_base "$target" "rm -rf $(quote "$staging_dir") && mkdir -p $(quote "$staging_dir") $(quote "$backup_dir")"
  scp_base -r "${LOCAL_RELEASE_DIR}/." "${target}:${staging_dir}/"

  local validation_shared_config="${REMOTE_DIR}/configs/market-data.live.example.json"
  if [[ "$DEPLOY_CONFIG" == "1" && -n "$EXTRA_CONFIG_FILE" ]]; then
    validation_shared_config="${staging_dir}/${EXTRA_CONFIG_FILE}"
  fi
  local validation_fleet_configs=()
  local fleet_config_path
  for fleet_config_path in "$STANDARD_CONFIG_FILE" "$SPXC_CONFIG_FILE" "$MEGATRON_CONFIG_FILE"; do
    if [[ "$DEPLOY_CONFIG" == "1" && "$fleet_config_path" == "$CONFIG_FILE" ]]; then
      validation_fleet_configs+=("${staging_dir}/${fleet_config_path}")
    else
      validation_fleet_configs+=("${REMOTE_DIR}/${fleet_config_path}")
    fi
  done

  echo "Validating staged release without live execution"
  if ! ssh_base "$target" "bash -lc $(quote "$(remote_validation_script "$commit" "$staging_dir" "$validation_shared_config" "${validation_fleet_configs[@]}")")"; then
    die "staged release validation failed; promotion aborted"
  fi

  echo "Evaluating broker/checkpoint activation gates before promotion"
  if ! ssh_base "$target" "bash -lc $(quote "$(remote_activation_gate_script pre_activation "${REMOTE_DIR}/${STANDARD_CONFIG_FILE}" "${staging_dir}/${STANDARD_CONFIG_FILE}" "${validation_shared_config}" "${staging_dir}/DEPLOYED_VERSION.json")")"; then
    die "pre-promotion broker/checkpoint gate failed; promotion aborted"
  fi

  echo "Validating deployment manifest before promotion"
  ssh_base "$target" "bash -lc $(quote "$(remote_mark_manifest_validated_script "$deployment_id" "$commit" "${staging_dir}/DEPLOYED_VERSION.json")")"

  echo "Backing up replaced runtime files to ${backup_dir}"
  ssh_base "$target" "bash -lc $(quote "$(remote_backup_script "$deployment_id" "$commit" "$backup_dir")")"

  echo "Promoting staged runtime files"
  ssh_base "$target" "bash -lc $(quote "$(remote_promote_script "$deployment_id" "$staging_dir")")"

  echo "Re-evaluating broker/checkpoint activation gates after promotion"
  if ! ssh_base "$target" "bash -lc $(quote "$(remote_activation_gate_script post_promotion "${backup_dir}/${STANDARD_CONFIG_FILE}" "${REMOTE_DIR}/${STANDARD_CONFIG_FILE}" "${REMOTE_DIR}/${MARKET_CONFIG_FILE}" "${staging_dir}/DEPLOYED_VERSION.json")")"; then
    echo "INCOMPLETE_DEPLOYMENT: post-promotion broker/checkpoint gate failed; manifest was not installed." >&2
    echo "INCOMPLETE_DEPLOYMENT deployment_id=${deployment_id}" >&2
    return 1
  fi

  echo "Writing deployment manifest"
  if ! ssh_base "$target" "bash -lc $(quote "$(remote_install_manifest_script "$deployment_id" "$commit" "${staging_dir}/DEPLOYED_VERSION.json" "${REMOTE_DIR}/DEPLOYED_VERSION.json")")"; then
    echo "INCOMPLETE_DEPLOYMENT: runtime promotion completed but DEPLOYED_VERSION.json was not installed." >&2
    echo "INCOMPLETE_DEPLOYMENT deployment_id=${deployment_id}" >&2
    echo "Recovery options: rerun the same commit with --no-restart after fixing deployment, or rollback ${deployment_id} without restart after separate approval." >&2
    return 1
  fi

  echo "Cleaning promoted old runtime siblings after durable manifest"
  ssh_base "$target" "bash -lc $(quote "$(remote_cleanup_old_script "$deployment_id")")"

  cleanup_local_resources
  echo "Deploy complete without service restart. Use ./deploy-trading --restart-fleet after separate approval."
}

validate_local_manifest() {
  local manifest_file="$1"
  local deployment_id="$2"
  local commit="$3"
  local expected_status="$4"
  python3 - "$manifest_file" "$deployment_id" "$commit" "$expected_status" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
deployment_id = sys.argv[2]
commit = sys.argv[3]
expected_status = sys.argv[4]

with path.open("r", encoding="utf-8") as handle:
    data = json.load(handle)

required = {
    "deployment_id",
    "git_commit",
    "deployed_at",
    "source_repository",
    "payload_groups",
    "requirements_hash",
    "config_policy",
    "backup_id",
    "backup_path",
    "validation_status",
}
missing = sorted(required.difference(data))
if missing:
    raise SystemExit(f"manifest missing required fields: {missing}")
if data["deployment_id"] != deployment_id:
    raise SystemExit("manifest deployment_id mismatch")
if data["git_commit"] != commit:
    raise SystemExit("manifest git_commit mismatch")
if data["validation_status"] != expected_status:
    raise SystemExit("manifest validation_status mismatch")
if "historical_checkpoint_authorizations" in data and not isinstance(data["historical_checkpoint_authorizations"], list):
    raise SystemExit("manifest historical_checkpoint_authorizations must be a list")
PY
}

remote_manifest_python() {
  cat <<'PY'
import json
import os
import sys
from pathlib import Path

REQUIRED = {
    "deployment_id",
    "git_commit",
    "deployed_at",
    "source_repository",
    "payload_groups",
    "requirements_hash",
    "config_policy",
    "backup_id",
    "backup_path",
    "validation_status",
}

def load_manifest(path: Path) -> dict:
    text = path.read_text(encoding="utf-8")
    data = json.loads(text)
    missing = sorted(REQUIRED.difference(data))
    if missing:
        raise SystemExit(f"manifest missing required fields: {missing}")
    if "historical_checkpoint_authorizations" in data and not isinstance(data["historical_checkpoint_authorizations"], list):
        raise SystemExit("manifest historical_checkpoint_authorizations must be a list")
    return data

def write_manifest(path: Path, data: dict) -> None:
    tmp = path.with_name(f"{path.name}.__tmp__.{data['deployment_id']}")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")
    reparsed = load_manifest(tmp)
    if reparsed != data:
        raise SystemExit("manifest write verification mismatch")
    os.replace(tmp, path)

mode = sys.argv[1]
deployment_id = sys.argv[2]
commit = sys.argv[3]

if mode == "mark_validated":
    manifest_path = Path(sys.argv[4])
    data = load_manifest(manifest_path)
    if data["deployment_id"] != deployment_id:
        raise SystemExit("manifest deployment_id mismatch")
    if data["git_commit"] != commit:
        raise SystemExit("manifest git_commit mismatch")
    if data["validation_status"] not in {"generated", "passed"}:
        raise SystemExit("manifest validation_status is not pre-promotion successful")
    data["validation_status"] = "passed"
    write_manifest(manifest_path, data)
elif mode == "install_passed":
    staged_manifest = Path(sys.argv[4])
    final_manifest = Path(sys.argv[5])
    data = load_manifest(staged_manifest)
    if data["deployment_id"] != deployment_id:
        raise SystemExit("manifest deployment_id mismatch")
    if data["git_commit"] != commit:
        raise SystemExit("manifest git_commit mismatch")
    if data["validation_status"] != "passed":
        raise SystemExit("manifest was not validated before promotion")
    final_manifest.parent.mkdir(parents=True, exist_ok=True)
    write_manifest(final_manifest, data)
    (final_manifest.parent / ".last_successful_deployment_id").write_text(deployment_id + "\n", encoding="utf-8")
    (final_manifest.parent / ".last_deployment_id").write_text(deployment_id + "\n", encoding="utf-8")
else:
    raise SystemExit(f"unknown manifest mode: {mode}")
PY
}

