rollback_deployment() {
  local deployment_id="$1"
  local target backup_dir
  validate_deployment_id "$deployment_id"
  target="$(remote_target)"
  backup_dir="/root/deploy-backups/${deployment_id}"
  if [[ "$DRY_RUN" == "1" ]]; then
    cat <<EOF
DRY RUN ONLY - no remote changes will be made.
Rollback deployment ID: ${deployment_id}
Backup path: ${backup_dir}
Would restore backed-up runtime files, shared/, silver/, service files, requirements.txt.
Would restore config only if ${backup_dir}/${CONFIG_FILE} exists.
Would preserve artifacts, venv, evidence, logs, and state.
Would run non-trading validation after restoration.
Fleet restart requested: ${RESTART_FLEET}
Mission-control restart requested: ${RESTART_MISSION}
EOF
    return
  fi
  ssh_base "$target" "bash -lc $(quote "$(remote_rollback_script "$deployment_id" "$backup_dir")")"
  if [[ "$RESTART_FLEET" == "1" ]]; then
    restart_fleet_only
  fi
  if [[ "$RESTART_MISSION" == "1" ]]; then
    restart_mission_only
  fi
}

remote_rollback_script() {
  local deployment_id="$1"
  local backup_dir="$2"
  cat <<EOF
set -euo pipefail
test -d $(quote "$backup_dir")
cd $(quote "$REMOTE_DIR")
txn_kind=()
txn_name=()
txn_old=()
txn_new=()
txn_had_active=()
txn_state=()
set_txn_state() {
  txn_state[\$1]="\$2"
}
restore_txn() {
  set +e
  local idx="\$1"
  local kind="\${txn_kind[\$idx]}"
  local name="\${txn_name[\$idx]}"
  local old="\${txn_old[\$idx]}"
  local new="\${txn_new[\$idx]}"
  local had_active="\${txn_had_active[\$idx]}"
  local state="\${txn_state[\$idx]}"
  if [[ "\$state" == "restored" ]]; then
    return 0
  fi
  if [[ "\$kind" == "dir" ]]; then
    if [[ "\$state" == "activated" && -d "\$name" ]]; then
      rm -rf "\$name"
    fi
    if [[ "\$had_active" == "1" && -d "\$old" ]]; then
      rm -rf "\$name"
      mv "\$old" "\$name"
    elif [[ "\$had_active" == "0" && "\$state" == "activated" ]]; then
      rm -rf "\$name"
    fi
    rm -rf "\$new"
  else
    if [[ "\$state" == "activated" && -e "\$name" ]]; then
      rm -f "\$name"
    fi
    if [[ "\$had_active" == "1" && -e "\$old" ]]; then
      rm -f "\$name"
      mv "\$old" "\$name"
    elif [[ "\$had_active" == "0" && "\$state" == "activated" ]]; then
      rm -f "\$name"
    fi
    rm -f "\$new"
  fi
  set_txn_state "\$idx" "restored"
  set -e
  return 0
}
restore_rollback() {
  set +e
  local idx
  for ((idx=\${#txn_kind[@]} - 1; idx >= 0; idx--)); do
    restore_txn "\$idx"
  done
  exit 1
}
trap restore_rollback ERR
