main() {
  parse_args "$@"
  validate_remote_dir
  if [[ -n "$COMMIT_ARG" && "$ROLLBACK_REQUESTED" == "1" ]]; then
    die "--commit and --rollback are mutually exclusive"
  fi
  if [[ -n "$COMMIT_ARG" && "$RESTART_FLEET" == "1" ]]; then
    die "deploy and restart are separate; run --restart-fleet after deployment"
  fi
  if [[ -n "$COMMIT_ARG" && "$RESTART_MISSION" == "1" ]]; then
    die "deploy and mission-control restart are separate"
  fi
  if [[ -z "$COMMIT_ARG" && "$ROLLBACK_REQUESTED" == "0" && "$RESTART_FLEET" == "0" && "$RESTART_MISSION" == "0" ]]; then
    usage
    die "choose --commit, --rollback, --restart-fleet, or --restart-mission-control"
  fi

  if [[ -n "$COMMIT_ARG" ]]; then
    warn_if_dirty_worktree
    local full_sha deployment_id
    full_sha="$(resolve_commit "$COMMIT_ARG")"
    trap cleanup_all EXIT
    create_clean_commit_source "$full_sha"
    require_payload_exists "$CLEAN_SOURCE"
    deployment_id="$(deployment_id_for "$full_sha")"
    validate_deployment_id "$deployment_id"
    if [[ "$DRY_RUN" == "1" ]]; then
      dry_run_commit "$full_sha" "$deployment_id"
      return
    fi
    deploy_commit "$full_sha" "$deployment_id"
    return
  fi

  if [[ "$ROLLBACK_REQUESTED" == "1" ]]; then
    rollback_deployment "$ROLLBACK_ID"
    return
  fi

  if [[ "$RESTART_FLEET" == "1" ]]; then
    restart_fleet_only
  fi
  if [[ "$RESTART_MISSION" == "1" ]]; then
    restart_mission_only
  fi
}

