remote_promote_script() {
  local deployment_id="$1"
  local staging_dir="$2"
  cat <<EOF
set -euo pipefail
cd $(quote "$REMOTE_DIR")
test -d $(quote "$staging_dir")/shared
test -d $(quote "$staging_dir")/silver
mkdir -p configs
txn_kind=()
txn_name=()
  txn_old=()
  txn_new=()
  txn_had_active=()
  txn_state=()
set_txn_state() {
  txn_state[\$1]="\$2"
}
restore_txn() {
  set +e
  local idx="\$1"
  local kind="\${txn_kind[\$idx]}"
  local name="\${txn_name[\$idx]}"
  local old="\${txn_old[\$idx]}"
  local new="\${txn_new[\$idx]}"
  local had_active="\${txn_had_active[\$idx]}"
  local state="\${txn_state[\$idx]}"
  if [[ "\$state" == "restored" ]]; then
    return 0
  fi
  if [[ "\$kind" == "dir" ]]; then
    if [[ "\$state" == "activated" && -d "\$name" ]]; then
      rm -rf "\$name"
    fi
    if [[ "\$had_active" == "1" && -d "\$old" ]]; then
      rm -rf "\$name"
      mv "\$old" "\$name"
    elif [[ "\$had_active" == "0" && "\$state" == "activated" ]]; then
      rm -rf "\$name"
    fi
    rm -rf "\$new"
  else
    if [[ "\$state" == "activated" && -e "\$name" ]]; then
      rm -f "\$name"
    fi
    if [[ "\$had_active" == "1" && -e "\$old" ]]; then
      rm -f "\$name"
      mv "\$old" "\$name"
    elif [[ "\$had_active" == "0" && "\$state" == "activated" ]]; then
      rm -f "\$name"
    fi
    rm -f "\$new"
  fi
  set_txn_state "\$idx" "restored"
  set -e
  return 0
}
