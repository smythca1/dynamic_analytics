[Unit]
Description=Trading Fleet Megatron Live Beta Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-server
EnvironmentFile=/root/trading-server/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/mkdir -p /root/trading-server/artifacts/live/megatron/state /root/trading-server/artifacts/live/megatron/events /root/trading-server/artifacts/live/megatron/orders /root/trading-server/artifacts/live/megatron/evidence /root/trading-server/artifacts/live/megatron/renko
ExecStart=/root/trading-server/venv/bin/python fleet_runner.py --config /root/trading-server/configs/accounts/megatron.live.json --execute-real --force-mode live --market-data-source local_archive_tail --archive-root /root/trading-server/artifacts/live/megatron --market-archive-root /root/trading-server/artifacts/live --local-market-poll-seconds 0.1 --log-output /root/trading-server/artifacts/live/megatron/events/fleet_events.jsonl --evidence-enabled --evidence-session-id megatron_tp_sl_beta_v1 --evidence-output /root/trading-server/artifacts/live/megatron/evidence/megatron_tp_sl_beta_v1.jsonl --log-ticks
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
