[Unit]
Description=Trading Fleet Live Engine
After=network-online.target trading-market-data-live.service
Wants=network-online.target trading-market-data-live.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-server
EnvironmentFile=/root/trading-server/.env
ExecStart=/root/trading-server/venv/bin/python fleet_runner.py --config /root/trading-server/configs/traders.live.example.json --execute-real --force-mode live --market-data-source shared_canonical_stream --shared-market-data-config /root/trading-server/configs/market-data.live.example.json --log-output /root/trading-server/artifacts/live/fleet_live_events.jsonl
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
